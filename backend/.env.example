# Copiar a .env. Nunca subir .env a git.
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Contraseña de la cuenta de demostración (jose.martinez@demo.femsa.test).
# Si no se define, se usa la que está en src/datos/memoria/datos-demo.ts. En Vercel es obligatoria.
# DEMO_PASSWORD=

# Fuente de datos: "sql" usa la base de abajo; si no se define, la API usa datos de demostración en memoria.
DATA_SOURCE=sql
DB_HOST=<servidor>.database.windows.net
DB_PORT=1433
DB_NAME=<base>
DB_USER=<usuario>
DB_PASSWORD=<contraseña>
# Solo para un SQL Server local con certificado autofirmado (Docker):
# DB_TRUST_CERT=true
